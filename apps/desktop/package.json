{
  "name": "autark",
  "productName": "Autark",
  "version": "0.3.21",
  "private": true,
  "description": "Local-first AI workforce: agents, chats, tasks and a calm to-do list",
  "author": "Teydra",
  "license": "Apache-2.0",
  "type": "module",
  "main": "app/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "runtime": "node scripts/build.mjs --only runtime && node app/runtime-cli.mjs",
    "wf": "node app/wf.mjs",
    "electron:latest": "node scripts/electron-latest.mjs",
    "typecheck": "tsc -p tsconfig.shared.json && tsc -p tsconfig.runtime.json && tsc -p tsconfig.main.json && tsc -p tsconfig.ui.json",
    "build:mac-helper": "node scripts/build-mac-helper.mjs",
    "boundaries": "node scripts/check-boundaries.mjs",
    "test": "node --test --test-concurrency=2 \"test/unit/**/*.test.ts\"",
    "test:ui": "node scripts/build.mjs && node --test --test-concurrency=1 \"test/ui/**/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.mjs\"",
    "test:real-rtc": "node --test --test-concurrency=1 test/native/rendezvous/phone-rtc.test.ts test/native/rendezvous/pc-rtc.test.ts test/native/hosted/rtc.test.ts test/native/hosted-rtc.test.mjs",
    "test:native-tcp": "node --test --test-concurrency=1 test/native/http/listen-ports.test.ts test/native/http/listen-companies.test.ts",
    "test:live": "node --test --test-concurrency=1 \"test/live/*.test.ts\"",
    "check": "npm run typecheck && npm run boundaries && npm test",
    "package": "npm run build && node scripts/package-desktop.mjs --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@thednp/dommatrix": "3.1.2",
    "croner": "10.0.1",
    "electron-updater": "6.8.9",
    "onnxruntime-web": "1.31.1",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.61.1",
    "qrcode": "1.5.4",
    "sherpa-onnx-node": "2.0.1",
    "werift": "0.27.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1",
    "@preact/signals": "2.11.3",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "7zip-bin": "5.2.0",
    "dompurify": "3.4.17",
    "electron": "45.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "marked": "18.1.1",
    "mediabunny": "^1.66.0",
    "mermaid": "12.2.0",
    "playwright": "1.61.1",
    "preact": "10.29.8",
    "typescript": "7.0.2"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "com.teydralab.workforce",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "app/**/*",
      "resources/**/*",
      "assets/icon.png",
      "assets/icons/**/*",
      "package.json",
      "!node_modules/@napi-rs/**/*",
      "!node_modules/onnxruntime-web/{dist,lib,docs}/**/*",
      "node_modules/onnxruntime-web/dist/ort.node.min.js",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm"
    ],
    "asarUnpack": [
      "resources/**/*.ps1",
      "resources/**/*.py",
      "resources/broker/*.exe",
      "resources/computer/darwin/*",
      "app/wf.mjs",
      "app/meet.mjs",
      "app/sleeper.mjs",
      "node_modules/sherpa-onnx-*/**",
      "node_modules/onnxruntime-web/**",
      "node_modules/onnxruntime-common/**"
    ],
    "artifactName": "autark-${version}-${os}-${arch}.${ext}",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "publish": {
      "provider": "github",
      "owner": "teydra",
      "repo": "OpenAutark",
      "releaseType": "draft"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "autark-windows-${arch}.${ext}",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "assets/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "autark-mac-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "identity": null,
      "x64ArchFiles": "{**/sherpa-onnx-darwin-*/**,**/computer/darwin/autark-mac-helper}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSAccessibilityUsageDescription": "Autark uses the Accessibility permission to operate other apps for you – click, type and read their controls – when you ask its agents to work on this Mac.",
        "NSMicrophoneUsageDescription": "Autark uses the microphone for calls with your agents, dictation and the floating to-do button.",
        "NSCameraUsageDescription": "Apps in the Autark workspace can ask for the camera, for example to record a video.",
        "NSAppleEventsUsageDescription": "Autark asks other apps to open documents and windows when you ask its agents to, and asks Terminal to run the sign-in of an AI engine such as Claude Code or Codex."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "autark-linux-x64.${ext}",
      "category": "Office",
      "icon": "assets/icon.png",
      "extraFiles": [{ "from": "resources/linux/com.teydralab.workforce.metainfo.xml", "to": "usr/share/metainfo/com.teydralab.workforce.metainfo.xml" }]
    }
  }
}
