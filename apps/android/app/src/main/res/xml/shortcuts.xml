<?xml version="1.0" encoding="utf-8"?>
<!-- Owns: the two home-screen shortcuts (long press on the app icon): Chats and Tasks open MainActivity with the
     extra "route" (#/chats, #/tasks; PhoneRoutes). The package is a string so the preview build (package ...preview,
     src/debug) points at itself. Never: a route the phone UI does not have. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="chats" android:enabled="true" android:icon="@mipmap/autark_launcher"
        android:shortcutShortLabel="@string/shortcut_chats" android:shortcutLongLabel="@string/shortcut_chats">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="@string/shortcut_package"
            android:targetClass="com.teydralab.autark.android.MainActivity">
            <extra android:name="route" android:value="#/chats" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="tasks" android:enabled="true" android:icon="@mipmap/autark_launcher"
        android:shortcutShortLabel="@string/shortcut_tasks" android:shortcutLongLabel="@string/shortcut_tasks">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="@string/shortcut_package"
            android:targetClass="com.teydralab.autark.android.MainActivity">
            <extra android:name="route" android:value="#/tasks" />
        </intent>
    </shortcut>
</shortcuts>
